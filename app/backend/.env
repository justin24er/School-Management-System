# Copy this file to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# Database
# In development this project uses SQLite (file-based, zero setup) so the
# prototype runs anywhere. The data access layer is written against plain
# SQL and a thin adapter (see src/db/adapter.js), so swapping to PostgreSQL
# in production means changing DB_CLIENT and the connection settings below,
# not rewriting the application code. See docs/README-internal.md,
# "Moving from SQLite to PostgreSQL".
DB_CLIENT=sqlite
SQLITE_FILE=./data/school_management.db

# PostgreSQL (used when DB_CLIENT=postgres)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=school_management
PG_USER=school_management_app
PG_PASSWORD=changeme

# Session / cookie secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-value

# Cookie security. Set to true in production (requires HTTPS).
COOKIE_SECURE=false

# Password reset / invitation token lifetime, in minutes
RESET_TOKEN_TTL_MINUTES=30
INVITE_TOKEN_TTL_HOURS=72

# Bootstrap: creates exactly one Platform Admin account on first migrate run
# if no Admin exists yet. Remove or blank these after first deployment.
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisImmediately!123

# Free trial length in days
TRIAL_LENGTH_DAYS=30
